{
  "name": "time-manage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:unused": "tsc -p tsconfig.app.json --noUnusedLocals --noUnusedParameters --pretty false",
    "typecheck:test": "tsc --noEmit",
    "audit:health": "node scripts/audit-code-health.mjs",
    "verify:quality": "npm run typecheck:unused && npm run audit:health",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "verify:fast": "npm test -- --run && npm run build",
    "verify:e2e": "npm run test:e2e",
    "verify:backend": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH go test ./...",
    "deploy:team": "bash scripts/package-timemanage-team.sh",
    "release:team:create-tag": "bash scripts/create-timemanage-release-tag.sh",
    "release:team:tag": "bash scripts/package-timemanage-team-from-tag.sh",
    "remote:gateway": "node scripts/remote-gateway.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli:build": "esbuild mcp-server/src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcp-server/dist/cli.js",
    "plugin:build": "node scripts/build-timemanage-codex-plugin.mjs",
    "plugin:validate": "node scripts/validate-timemanage-codex-plugin.mjs",
    "plugin:test": "npm run plugin:build && npm run plugin:validate",
    "backend:build": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH go build -trimpath -ldflags=\"-s -w\" -o bin/timemanage-team .",
    "backend:build:windows": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH GOOS=windows GOARCH=amd64 go build -trimpath -ldflags=\"-s -w\" -o bin/timemanage-team.exe .",
    "backend:server": "./team-server/bin/timemanage-team serve --config team-server/backend.local.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.5"
  }
}
