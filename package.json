{
  "name": "time-manage",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:desktop": "tsc -p tsconfig.app.json && vite build --mode desktop-production",
    "build:ios": "tsc -p tsconfig.app.json && vite build --mode ios-production",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:unused": "tsc -p tsconfig.app.json --noUnusedLocals --noUnusedParameters --pretty false",
    "typecheck:test": "tsc --noEmit",
    "audit:health": "node scripts/audit-code-health.mjs",
    "verify:agents": "node --test scripts/verify-agent-instructions.test.mjs && node scripts/verify-agent-instructions.mjs",
    "verify:quality": "npm run typecheck:unused && npm run audit:health && npm run verify:agents && npm run audit:cli && npm run audit:data-safety && npm run verify:version && npm run verify:release-contract && npm run verify:database-migrations && npm run verify:desktop:release && npm run verify:ios:release && node scripts/validate-ios-store-metadata.mjs",
    "verify:version": "node scripts/verify-release-version.mjs",
    "verify:release-contract": "node scripts/verify-release-contract.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "verify:desktop:release": "node scripts/verify-desktop-release.mjs",
    "verify:ios:release": "node scripts/verify-ios-release.mjs",
    "screenshots:ios:store": "TM_APP_STORE_SCREENSHOTS_DIR=deploy/app-store-screenshots playwright test --project=mobile-max-webkit tests/e2e/mobile-visual.spec.ts",
    "package:ios:release": "bash scripts/package-ios-release.sh",
    "verify:database-migrations": "node scripts/verify-database-migrations.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "verify:fast": "npm test -- --run && npm run build",
    "verify:e2e": "npm run test:e2e",
    "verify:backend": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH go test ./...",
    "deploy:team": "bash scripts/package-timemanage-team.sh",
    "release:team:create-tag": "bash scripts/create-timemanage-release-tag.sh",
    "release:team:tag": "bash scripts/package-timemanage-team-from-tag.sh",
    "remote:gateway": "node scripts/remote-gateway.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri-dev.mjs",
    "tauri:dev:raw": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:info": "tauri info",
    "test:tauri:smoke": "node scripts/run-tauri-smoke.mjs",
    "test:tauri:functional:real": "node scripts/run-tauri-functional-real.mjs",
    "verify:functional": "npm run verify:fast && npm run verify:backend && npm run verify:e2e && npm run tauri:info && npm run tauri:build && npm run test:tauri:smoke",
    "cli:typecheck": "tsc -p cli/tsconfig.json",
    "cli:test": "vitest run cli/src",
    "cli:build": "esbuild cli/src/cli.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=cli/dist/cli.js",
    "audit:cli": "node scripts/audit-cli-architecture.mjs",
    "audit:data-safety": "node scripts/audit-data-safety.mjs",
    "plugin:build": "node scripts/build-timemanage-codex-plugin.mjs",
    "plugin:validate": "node scripts/validate-timemanage-codex-plugin.mjs",
    "plugin:test": "npm run cli:typecheck && npm run cli:test && npm run plugin:build && npm run plugin:validate",
    "backend:build": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH go build -trimpath -ldflags=\"-s -w\" -o bin/timemanage-team .",
    "backend:build:windows": "cd team-server && PATH=/Volumes/MacSSD/env/Go/bin:$PATH GOOS=windows GOARCH=amd64 go build -trimpath -ldflags=\"-s -w\" -o bin/timemanage-team.exe .",
    "backend:server": "./team-server/bin/timemanage-team serve --config team-server/backend.local.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "commander": "^14.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.5",
    "webdriverio": "^9.29.1"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
