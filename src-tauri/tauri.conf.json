{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeManage",
  "version": "0.1.0",
  "identifier": "com.timemanage.focus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeManage",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "自律型番茄时间管理系统",
    "longDescription": "本地优先的自律番茄系统，覆盖任务池、今日承诺、严格模式和复盘报告。"
  }
}

